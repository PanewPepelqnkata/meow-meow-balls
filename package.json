{
  "name": "ball-rush",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "qa:tier8": "node qa/verify-tier8-bake.mjs",
    "qa:containment": "node qa/verify-fault-containment.mjs",
    "qa:merge": "node qa/verify-deferred-merge.mjs",
    "qa:tier8cycle": "node qa/verify-tier8-cycling.mjs",
    "qa:wallraise": "node qa/verify-wall-raise.mjs",
    "qa:fear": "node qa/verify-fear-phases.mjs",
    "qa:gameoverpanic": "node qa/verify-gameover-panic.mjs",
    "qa:fearplay": "node qa/verify-fear-in-play.mjs",
    "qa:themebake": "node qa/verify-theme-bake.mjs",
    "qa:savewrite": "node qa/verify-save-write.mjs",
    "qa:proddiag": "node qa/verify-prod-diag.mjs",
    "qa:discsize": "node qa/verify-discovery-size.mjs",
    "qa:card": "node qa/verify-collectible-card.mjs",
    "qa:wallperf": "node qa/verify-wall-raise-perf.mjs",
    "format": "prettier --write ."
  },
  "dependencies": {
    "matter-js": "^0.20.0",
    "phaser": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
